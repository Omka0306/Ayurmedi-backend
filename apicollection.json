    {
      "name": "Hospital Management",
      "item": [
        {
          "name": "Register Hospital",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.hospital) {",
                  "        pm.collectionVariables.set('hospitalId', response.data.hospital.hospital_id);",
                  "        console.log('Hospital ID saved:', response.data.hospital.hospital_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{superAdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospital_code\": \"HOSP001\",\n  \"name\": \"Test Hospital\",\n  \"address\": \"123 Main Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"pincode\": \"400001\",\n  \"contact_number\": \"9876543210\",\n  \"email\": \"contact@hospital1.com\",\n  \"admin_email\": \"admin@hospital1.com\",\n  \"admin_password\": \"HospitalAdmin@123\",\n  \"admin_full_name\": \"Hospital Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hospital",
                "register"
              ]
            },
            "description": "Register a new hospital (SUPER_ADMIN only)"
          }
        }
      ]
    },
