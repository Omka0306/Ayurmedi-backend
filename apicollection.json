{
  "info": {
    "name": "Ayurmedi Backend API - Complete Collection",
    "description": "Complete API collection for Ayurmedi Backend - Hospital Management System\nIncludes: Auth, Hospital, Users, Master Data (Medicines, Dropdowns, Diseases, Treatments, Prescription Templates), and Patient Flow (Patients, Visits, History, Prescriptions)",
