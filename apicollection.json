    {
      "name": "Medicines",
      "item": [
        {
          "name": "Create Medicine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalAdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name_mr\": \"पॅरासिटामोल\",\n  \"name_en\": \"Paracetamol\",\n  \"medicine_type\": \"ALLOPATHY\",\n  \"description\": \"Pain relief and fever reducer\",\n  \"dosage_form\": \"Tablet\",\n  \"strength\": \"500mg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medicines/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medicines",
                "create"
              ]
            },
            "description": "Create a new medicine"
          }
        },
        {
          "name": "List Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/list?medicine_type=ALLOPATHY&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medicines",
                "list"
              ],
              "query": [
                {
                  "key": "medicine_type",
                  "value": "ALLOPATHY",
                  "description": "Optional: ALLOPATHY, AYURVEDIC, HOMEOPATHY"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Number of results"
                }
              ]
            },
            "description": "Get list of medicines for the hospital"
          }
        },
        {
          "name": "Search Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/search?query=para",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medicines",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "para",
                  "description": "Search term"
                }
              ]
            },
            "description": "Search medicines by name (Marathi or English)"
          }
        },
        {
          "name": "Update Medicine Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalAdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medicines/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medicines",
                ":id",
                "status"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "medicine-id-here"
                }
              ]
            },
            "description": "Activate or deactivate a medicine"
          }
        }
      ]
