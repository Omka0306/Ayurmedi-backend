      "description": "OPD Visit management with queue and stage tracking.\nStages: WAITING_FOR_HISTORY → READY_FOR_DOCTOR → READY_FOR_BILLING\nRole: RECEPTION, DOCTOR, SUPER_ADMIN",
      "item": [
        {
          "name": "Create Visit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data?.visit?.visit_id) {",
                  "        pm.collectionVariables.set('visitId', response.data.visit.visit_id);",
                  "        console.log('Visit ID saved:', response.data.visit.visit_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"visit_date\": \"2026-03-01\",\n  \"visit_time\": \"10:30\",\n  \"weight\": 72,\n  \"current_illness\": \"Fever and body ache\",\n  \"doctor_id\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visits/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "visits",
                "create"
              ]
            },
            "description": "Create OPD Visit. doctor_id is OPTIONAL. Sets status=OPEN, stage=WAITING_FOR_HISTORY."
          }
        },
