            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Robert Johnson\",\n  \"email\": \"assistant1@hospital1.com\",\n  \"mobile\": \"+919876543213\",\n  \"role\": \"ASSISTANT\",\n  \"password\": \"Assistant@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "create"
              ]
            },
            "description": "Create an assistant user within the hospital."
          },
          "response": []
        }
      ],
      "description": "User management endpoints for creating hospital staff"
    }
